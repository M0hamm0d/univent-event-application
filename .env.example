# Frontend (Vite) — exposed to the browser. Use the Supabase anon key only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: Do NOT put server-only secrets (OpenAI, service role, email passwords)
# in VITE_ vars — they are bundled into the client and visible to anyone.
# Server-side secrets belong in Vercel project settings / the api/ runtime env.

# ---- Serverless (api/) env vars — set in Vercel, NOT here ----
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SERVICE_ROLE_KEY=your-service-role-key
# EMAIL_USER=your-gmail-address@gmail.com
# EMAIL_PASS=your-gmail-app-password
# API_EMAIL_SECRET=a-long-random-string-shared-with-cron-callers
